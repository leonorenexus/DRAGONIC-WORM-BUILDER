<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#FF1A0000" />
            <stroke android:width="1dp" android:color="@color/border2" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:type="linear"
                    android:angle="0"
                    android:startColor="@color/neon_red_dark"
                    android:endColor="@color/neon_red" />
            </shape>
        </clip>
    </item>
</layer-list>
