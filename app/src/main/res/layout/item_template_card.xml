<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/bg_template_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tplIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔧"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/tplName"
        style="@style/Text.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Basic Tool"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/tplDesc"
        style="@style/Text.Mono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Simple CLI tool"
        android:textColor="@color/ghost_gray"
        android:textSize="9sp" />

    <LinearLayout
        android:id="@+id/layoutTplLangs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal" />

</LinearLayout>
