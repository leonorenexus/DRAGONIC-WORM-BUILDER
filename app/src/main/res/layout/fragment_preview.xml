<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/void_black"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Tab strip -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_card_glass"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/tabStrip"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Banner preview -->
            <LinearLayout
                android:id="@+id/paneBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_glass"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="visible">

                <TextView
                    style="@style/Text.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Banner Preview" />

                <TextView
                    android:id="@+id/txtBannerPreview"
                    style="@style/Text.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/code_bg"
                    android:padding="12dp"
                    android:scrollHorizontally="true"
                    android:textColor="@color/neon_red"
                    android:textSize="7sp" />

            </LinearLayout>

            <!-- README preview -->
            <LinearLayout
                android:id="@+id/paneReadme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_glass"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    style="@style/Text.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="README.md" />

                <TextView
                    android:id="@+id/txtReadmePreview"
                    style="@style/Text.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_code_block"
                    android:padding="12dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- Structure preview -->
            <LinearLayout
                android:id="@+id/paneStructure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_glass"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    style="@style/Text.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="File Structure" />

                <TextView
                    android:id="@+id/txtStructurePreview"
                    style="@style/Text.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_code_block"
                    android:padding="12dp"
                    android:textColor="@color/neon_red"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Menu preview -->
            <LinearLayout
                android:id="@+id/paneMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_glass"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    style="@style/Text.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Menu Preview" />

                <TextView
                    android:id="@+id/txtMenuPreview"
                    style="@style/Text.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_code_block"
                    android:padding="12dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Deps preview -->
            <LinearLayout
                android:id="@+id/paneDeps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_glass"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    style="@style/Text.CardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Dependencies" />

                <TextView
                    android:id="@+id/txtDepsPreview"
                    style="@style/Text.Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_code_block"
                    android:padding="12dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
