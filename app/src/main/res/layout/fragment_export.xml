<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/void_black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_glass"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Text.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Export Project" />

            <TextView
                android:id="@+id/txtExportInfo"
                style="@style/Text.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_code_block"
                android:lineSpacingExtra="4dp"
                android:padding="14dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Progress -->
            <LinearLayout
                android:id="@+id/progressContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtProgressMsg"
                        style="@style/Text.Mono"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Generating..."
                        android:textColor="@color/neon_red"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/txtProgressPct"
                        style="@style/Text.Mono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="@color/neon_red"
                        android:textSize="10sp" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="12dp"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_bar_dragonic" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDownloadZip"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/download_zip" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareZip"
                style="@style/Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/share_zip" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackToConfig"
                style="@style/Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="← Back to Config" />

        </LinearLayout>

        <!-- Structure preview -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_glass"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Text.CardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Output Contents" />

            <TextView
                android:id="@+id/txtOutputStructure"
                style="@style/Text.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_code_block"
                android:padding="12dp"
                android:textColor="@color/neon_red"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
