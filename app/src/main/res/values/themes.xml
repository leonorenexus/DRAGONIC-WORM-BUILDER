<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.DragonicWorm" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/neon_red</item>
        <item name="colorPrimaryVariant">@color/neon_red_dim</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/neon_red_dim</item>
        <item name="colorSecondaryVariant">@color/neon_red_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/void_black</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/void_black</item>
        <item name="android:navigationBarColor">@color/void_black</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowBackground">@color/void_black</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.DragonicWorm.Dialog</item>
    </style>

    <style name="Theme.DragonicWorm.Splash" parent="Theme.DragonicWorm">
        <item name="android:windowBackground">@drawable/bg_splash</item>
    </style>

    <style name="ThemeOverlay.DragonicWorm.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/neon_red</item>
    </style>

    <!-- Text Styles - use Widget.AppCompat.TextView as valid parent -->
    <style name="Text.Display" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textColor">@color/neon_red</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="Text.Mono" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Text.Body" parent="Widget.AppCompat.TextView">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.CardTitle" parent="Text.Display">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Buttons -->
    <style name="Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/neon_red</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="cornerRadius">2dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Button.Ghost" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/neon_red_dark</item>
        <item name="android:textColor">@color/neon_red</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="cornerRadius">2dp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Input -->
    <style name="Input.Field" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/neon_red_dark</item>
        <item name="boxBackgroundColor">@color/card_bg</item>
        <item name="hintTextColor">@color/neon_red</item>
        <item name="android:textColorHint">@color/text_dim</item>
        <item name="boxCornerRadiusTopStart">2dp</item>
        <item name="boxCornerRadiusTopEnd">2dp</item>
        <item name="boxCornerRadiusBottomStart">2dp</item>
        <item name="boxCornerRadiusBottomEnd">2dp</item>
    </style>

</resources>
